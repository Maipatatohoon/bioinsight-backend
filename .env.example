# --- Backend (FastAPI) configuration ---
# Shared bearer token required by the worker endpoints. ALWAYS change this.
BIOINSIGHT_WORKER_TOKEN=change-me

# Where the worker reaches the backend (worker-side).
BIOINSIGHT_BACKEND_URL=http://localhost:8000

# SQLite job database location (persisted; defaults to backend/data/).
BIOINSIGHT_DB_PATH=./data/bioinsight_jobs.db

# Comma-separated list of allowed browser origins (CORS).
BIOINSIGHT_ALLOWED_ORIGINS=http://localhost:3000

# "production" makes the backend refuse to start with the default token.
BIOINSIGHT_ENV=development
